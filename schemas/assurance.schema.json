{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project assurance controls",
  "type": "object",
  "required": ["schema_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "secret_scan": {
      "type": "object", "additionalProperties": false, "required": ["mode"],
      "properties": {"mode": {"enum": ["worktree", "changes", "history"]}, "base_ref": {"type": "string", "minLength": 1}},
      "if": {"properties": {"mode": {"const": "changes"}}},
      "then": {"required": ["base_ref"]},
      "else": {"not": {"required": ["base_ref"]}}
    },
    "deployments": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "secret_contracts": {"type": "array", "items": {
      "type": "object", "required": ["root", "runtime_files"], "additionalProperties": false,
      "properties": {"root": {"type": "string", "minLength": 1}, "runtime_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}
    }}
  }
}
