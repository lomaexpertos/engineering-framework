{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initiative state",
  "type": "object",
  "required": ["schema_version", "id", "title", "owner", "status", "revision", "created_at", "updated_at", "closed_at", "retain_until", "hold", "active_tasks", "blockers", "blocked_from", "blocked_reason"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[0-9]{8}_[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "title": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "status": {"enum": ["draft", "ready", "active", "blocked", "validating", "closing", "closed", "cancelled"]},
    "revision": {"type": "integer", "minimum": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "closed_at": {"type": ["string", "null"], "format": "date-time"},
    "retain_until": {"type": ["string", "null"], "format": "date-time"},
    "hold": {"type": ["string", "null"]},
    "active_tasks": {"type": "array"},
    "blockers": {"type": "array"},
    "blocked_from": {"type": ["string", "null"]},
    "blocked_reason": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
