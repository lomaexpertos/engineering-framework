{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Encrypted dotenv assurance contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["root", "runtime_files"],
  "properties": {
    "root": {"type": "string", "minLength": 1},
    "runtime_files": {"type": "array", "minItems": 1, "maxItems": 1000, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
