{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Compact delivery closure",
  "type": "object",
  "required": [
    "reviewer",
    "reviewed_at",
    "summary",
    "validation",
    "sources"
  ],
  "properties": {
    "reviewer": {
      "type": "string",
      "minLength": 1
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "validation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "outcome",
          "evidence"
        ],
        "properties": {
          "command": {
            "type": "string",
            "minLength": 1
          },
          "outcome": {
            "enum": [
              "passed",
              "failed",
              "not_run"
            ]
          },
          "evidence": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
