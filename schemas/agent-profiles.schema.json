{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Personal agent profiles",
  "type": "object",
  "required": ["schema_version", "profiles", "roles"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {
      "type": "object",
      "propertyNames": {"pattern": "^[a-z][a-z0-9-]{0,63}$"},
      "additionalProperties": {
        "type": "object",
        "required": ["adapter", "model"],
        "properties": {
          "adapter": {"enum": ["codex", "claude", "opencode"]},
          "model": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f]+$"},
          "executable": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^(?:/[^\\u0000-\\u001f]*|[^/\\\\\\s]+)$"},
          "permission": {"enum": ["read-only", "workspace-write"]},
          "client_profile": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f]+$"},
          "shell_allowlist": {"type": "array", "maxItems": 32, "items": {"type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[^\\u0000-\\u001f]+$"}}
        },
        "additionalProperties": false,
        "allOf": [
          {"if": {"properties": {"adapter": {"const": "opencode"}}}, "then": {"properties": {"model": {"pattern": "^[^/\\s]+/\\S+$"}}}},
          {"if": {"required": ["client_profile"]}, "then": {"properties": {"adapter": {"const": "codex"}}}},
          {"if": {"required": ["shell_allowlist"]}, "then": {"properties": {"adapter": {"enum": ["claude", "opencode"]}}}}
        ]
      }
    },
    "roles": {
      "type": "object",
      "propertyNames": {"enum": ["definition", "implementation", "functional", "security", "logging", "ui", "ux"]},
      "additionalProperties": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$"}
    },
    "limits": {"$ref": "#/$defs/limits"}
  },
  "additionalProperties": false,
  "$defs": {
    "limits": {
      "type": "object",
      "properties": {
        "max_concurrency": {"type": "integer", "minimum": 1, "maximum": 16},
        "timeout_seconds": {"type": "integer", "minimum": 1, "maximum": 86400},
        "max_correction_rounds": {"type": "integer", "minimum": 0, "maximum": 10}
      },
      "additionalProperties": false
    }
  }
}
