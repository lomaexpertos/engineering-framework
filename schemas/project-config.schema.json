{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project harness extensions",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "profiles": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "runners": {"type": "object", "additionalProperties": {"type": "object", "required": ["image"], "properties": {"image": {"type": "string", "minLength": 1}}}},
    "checks": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "scope", "required", "argv", "runner", "timeout_seconds", "evidence", "applicability"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "scope": {"type": "string", "minLength": 1},
        "required": {"type": "boolean"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "runner": {"type": "string", "minLength": 1},
        "timeout_seconds": {"type": "integer", "minimum": 1},
        "evidence": {"type": "string", "minLength": 1},
        "applicability": {"type": "string", "minLength": 1}
      }
    }}
  }
}
