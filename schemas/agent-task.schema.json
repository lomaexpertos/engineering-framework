{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Delegated agent task",
  "type": "object",
  "required": ["schema_version", "id", "initiative", "role", "objective", "scope", "exclusions", "ownership", "references", "acceptance", "dependencies", "permissions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,95}$"},
    "initiative": {"type": "string", "pattern": "^[0-9]{8}_[a-z0-9]+(?:_[a-z0-9]+)*$"},
    "role": {"enum": ["definition", "implementation", "functional", "security", "logging", "ui", "ux"]},
    "objective": {"type": "string", "minLength": 1},
    "scope": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]},
    "exclusions": {"$ref": "#/$defs/strings"},
    "ownership": {"$ref": "#/$defs/strings"},
    "references": {"$ref": "#/$defs/strings"},
    "acceptance": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]},
    "dependencies": {"$ref": "#/$defs/strings"},
    "permissions": {"enum": ["read-only", "workspace-write"]},
    "workspace": {"type": "string", "minLength": 1}
  },
  "additionalProperties": false,
  "allOf": [
    {"if": {"properties": {"role": {"not": {"const": "implementation"}}}}, "then": {"properties": {"permissions": {"const": "read-only"}}}},
    {"if": {"properties": {"permissions": {"const": "workspace-write"}}}, "then": {"properties": {"ownership": {"minItems": 1}}}}
  ],
  "$defs": {"strings": {"type": "array", "items": {"type": "string", "minLength": 1}}}
}
