{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Project agent requirements",
  "type": "object",
  "required": ["schema_version"],
  "properties": {
    "schema_version": {"const": 1},
    "minimum_track": {"enum": ["minimal", "standard", "reinforced"]},
    "required_roles": {"type": "array", "items": {"enum": ["definition", "implementation", "functional", "security", "logging", "ui", "ux"]}, "uniqueItems": true},
    "allowed_adapters": {"type": "array", "items": {"enum": ["codex", "claude", "opencode"]}, "uniqueItems": true},
    "model_allowlist": {
      "type": "object",
      "propertyNames": {"enum": ["definition", "implementation", "functional", "security", "logging", "ui", "ux"]},
      "additionalProperties": {"type": "array", "items": {"type": "string", "minLength": 1}, "minItems": 1, "uniqueItems": true}
    },
    "limits": {"$ref": "agent-profiles.schema.json#/$defs/limits"}
  },
  "additionalProperties": false
}
