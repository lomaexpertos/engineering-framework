{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Production deployment contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment",
    "units",
    "services"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "environment": {
      "const": "production"
    },
    "units": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/unit"
      }
    },
    "services": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/service"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?=.*\\S)[^\\u0000\\r\\n]+$"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "topology",
        "runtime",
        "artifact",
        "automation"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "topology": {
          "$ref": "#/$defs/text"
        },
        "runtime": {
          "$ref": "#/$defs/text"
        },
        "artifact": {
          "$ref": "#/$defs/text"
        },
        "automation": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "health": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/text"
          }
        },
        "reason": {
          "$ref": "#/$defs/text"
        }
      },
      "oneOf": [
        {
          "required": [
            "command"
          ]
        },
        {
          "required": [
            "reason"
          ]
        }
      ]
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "unit",
        "strategy",
        "health_check",
        "depends_on",
        "modifies_schema",
        "migrations"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "unit": {
          "$ref": "#/$defs/id"
        },
        "strategy": {
          "enum": [
            "blue-green",
            "rolling",
            "recreate",
            "stateful",
            "external"
          ]
        },
        "health_check": {
          "$ref": "#/$defs/health"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        },
        "modifies_schema": {
          "type": "boolean"
        },
        "migrations": {
          "enum": [
            "none",
            "external",
            "automated"
          ]
        },
        "migration_entrypoint": {
          "$ref": "#/$defs/text"
        },
        "traffic_controller": {
          "$ref": "#/$defs/text"
        },
        "recovery": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "modifies_schema": {
                "const": true
              }
            }
          },
          "then": {
            "required": [
              "migration_entrypoint"
            ],
            "properties": {
              "migrations": {
                "enum": [
                  "external",
                  "automated"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "migrations": {
                "const": "none"
              }
            },
            "not": {
              "required": [
                "migration_entrypoint"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "enum": [
                  "blue-green",
                  "rolling"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "health_check": {
                "required": [
                  "command"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "blue-green"
              }
            }
          },
          "then": {
            "required": [
              "traffic_controller"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "strategy": {
                "const": "stateful"
              }
            }
          },
          "then": {
            "required": [
              "recovery"
            ]
          }
        }
      ]
    }
  }
}
